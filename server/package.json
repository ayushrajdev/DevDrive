{
  "name": "devdrive-api",
  "version": "1.0.0",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch --env-file=.env src/server.ts",
    "start": "node --env-file=.env dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test --test-concurrency=1 \"test/**/*.test.ts\"",
    "test:unit": "node --import tsx --test \"test/unit/*.test.ts\"",
    "test:integration": "node --import tsx --test \"test/integration/*.test.ts\"",
    "build:node": "node ./node_modules/typescript/bin/tsc",
    "typecheck:node": "node ./node_modules/typescript/bin/tsc --noEmit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1046.0",
    "@aws-sdk/s3-request-presigner": "^3.1046.0",
    "argon2": "^0.44.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^4.21.2",
    "google-auth-library": "^10.6.1",
    "helmet": "^8.1.0",
    "mongoose": "^9.2.1",
    "nodemailer": "^8.0.1",
    "razorpay": "^2.9.6",
    "redis": "^5.11.0",
    "stripe": "^22.1.1"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}

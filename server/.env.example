NODE_ENV=development
PORT=4000
MONGODB_URL=mongodb://127.0.0.1:27017/DevDrive
JWT_SECRET_KEY=replace-with-a-long-random-secret
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Session store: "memory" (default when no Redis is configured) or "redis".
# Setting REDIS_URL or REDIS_HOST selects Redis automatically.
SESSION_STORE=
REDIS_URL=
REDIS_HOST=
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=

# File storage (local disk by default). Set S3_BUCKET to enable presigned S3 uploads.
STORAGE_DIR=
AWS_REGION=ap-south-1
S3_BUCKET=

# Optional SMTP (OTP emails). Without it OTPs are stored but not emailed.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# Optional OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:4000/api/auth/github/callback

# Optional payments and webhooks
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

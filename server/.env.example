NODE_ENV=development
PORT=4000
MONGODB_URL=mongodb://127.0.0.1:27017/DevDrive
JWT_SECRET_KEY=replace-with-a-long-random-secret
MAX_DEVICE_LIMIT=2
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Optional Redis session store
REDIS_URL=
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=

# Optional SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# Optional OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/v2/auth/google/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:4000/api/v2/auth/github/callback

# Optional file storage
AWS_REGION=ap-south-1
S3_BUCKET=

# Optional payments and webhooks
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
